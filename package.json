{
	"name": "portainer-templates",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"health-check": "node -e \"fetch('http://localhost:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.0",
		"js-yaml": "^4.1.0",
		"sass": "^1.101.0",
		"snarkdown": "^2.0.0",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.2",
		"svelte-highlight": "^7.15.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.1.4"
	},
	"type": "module",
	"dependencies": {
		"@sentry/browser": "^10.65.0",
		"@sentry/sveltekit": "^10.65.0"
	}
}
